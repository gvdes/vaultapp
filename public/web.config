<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: requiere el módulo "URL Rewrite". Devuelve index.html para toda ruta que no sea un archivo real (SPA).
     Si la app vive en una subcarpeta, cambia la URL de la regla (por ejemplo /inventarios/index.html). -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SPA Quasar" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^/api(/|$)" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
